{
  "name": "@jorgemjuniorfitec/skills",
  "version": "0.1.0",
  "description": "CLI do marketplace interno de skills — instala skills de IA em Claude, Copilot e IDEs diversas",
  "type": "module",
  "bin": {
    "skills": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --dts",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorgemjuniorfitec/teste-repo.git"
  },
  "keywords": [
    "cli",
    "skills",
    "marketplace",
    "claude",
    "copilot",
    "ai"
  ],
  "author": "Fitec Labs",
  "license": "UNLICENSED",
  "dependencies": {
    "@inquirer/prompts": "^5.3.8",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.0.1",
    "simple-git": "^3.25.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.2.4",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
